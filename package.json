{
  "name": "tauri-plugin-liquid-glass-api",
  "version": "0.1.0",
  "description": "Apple Liquid Glass components for Tauri 2 — native iOS tab bar over the webview, macOS glass window background.",
  "license": "MIT",
  "author": "SoSweetHam <sosweetham@gmail.com>",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tauri",
    "tauri-plugin",
    "liquid-glass",
    "tab-bar",
    "ios",
    "macos"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "check-types": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": ">=2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
